local FixLagSection = Tabs.FixLag:AddSection("Tối Ưu Hóa FPS & Đồ Họa")

-- Hàm phụ trợ giảm đồ họa theo phần trăm
local function ReduceGraphicsPercent(percent)
    pcall(function()
        local allParts = Workspace:GetDescendants()
        local totalCount = #allParts
        local targetCount = math.floor(totalCount * (percent / 100))
        
        for i = 1, targetCount do
            local v = allParts[i]
            if v and v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
            end
        end
        
        Fluent:Notify({
            Title = "Fix Lag",
            Content = "Đã xóa " .. tostring(percent) .. "% Đồ Họa Gốc thành công!",
            Duration = 3
        })
    end)
end

-- Chức năng: Bật FPS Boost
