local function GetClosestEnemy()
    local ClosestEnemy = nil
    local MaxDistance = 2000

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local MyPos = LocalPlayer.Character.HumanoidRootPart.Position

        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
                local hum = v:FindFirstChildOfClass("Humanoid")
                if hum.Health > 0 and v.Name ~= LocalPlayer.Name and not Players:GetPlayerFromCharacter(v) then
                    if v.Name == "CityNPC" then
                        local Distance = (MyPos - v.HumanoidRootPart.Position).Magnitude
                        if Distance < MaxDistance then
                            MaxDistance = Distance
                            ClosestEnemy = v
                        end
                    end
                end
            end
        end
    end
    return ClosestEnemy
end

local function GetClosestPlayer()
    local ClosestPlayer = nil
    local MaxDistance = 1000

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local MyPos = LocalPlayer.Character.HumanoidRootPart.Position
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid") then
                if plr.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                    local dist = (MyPos - plr.Character.HumanoidRootPart.Position).Magnitude
                    if dist < MaxDistance then
                        MaxDistance = dist
                        ClosestPlayer = plr
                    end
                end
            end
        end
    end
    return ClosestPlayer
end

local function GetBossNPC2()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name == "NPC2" and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChildOfClass("Humanoid") then
            if v:FindFirstChildOfClass("Humanoid").Health > 0 then
                return v
            end
        end
    end
    return nil
end

local function GetAndSaveChairPosition(saveKey)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local MyPos = LocalPlayer.Character.HumanoidRootPart.Position
        local ClosestPos = nil
        local MinDistance = 20

        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                local Parent = v.Parent
                local PromptPos = nil

                if Parent:IsA("BasePart") then PromptPos = Parent.Position
                elseif Parent:IsA("Model") then
                    if Parent.PrimaryPart then PromptPos = Parent.PrimaryPart.Position
                    else
                        local Part = Parent:FindFirstChildOfClass("BasePart")
                        if Part then PromptPos = Part.Position end
                    end
                end

                if PromptPos then
                    local Distance = (MyPos - PromptPos).Magnitude
                    if Distance < MinDistance then
                        MinDistance = Distance
                        ClosestPos = PromptPos
                    end
                end
            end
        end

        if ClosestPos then
            _G[saveKey] = ClosestPos
            SavePositionsToConfig()
            return ClosestPos
        end
    end
    return nil
end

local function FarmAtSavedPosition(savedPos)
    pcall(function()
        if not savedPos then return end
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(savedPos + Vector3.new(0, 1.5, 0))
            
            for _, prompt in pairs(Workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    local ParentPart = prompt.Parent
                    local PromptPos = nil
                    
                    if ParentPart:IsA("BasePart") then PromptPos = ParentPart.Position
                    elseif ParentPart:IsA("Model") then
                        if ParentPart.PrimaryPart then PromptPos = ParentPart.PrimaryPart.Position
                        else
                            local Part = ParentPart:FindFirstChildOfClass("BasePart")
                            if Part then PromptPos = Part.Position end
                        end
                    end
                    
                    if PromptPos and (PromptPos - savedPos).Magnitude <= 10 then
                        fireproximityprompt(prompt)
                    end
                end
            end
        end
    end)
end

-- TỐI ƯU HÀM TỰ ĐỘNG ĐÁNH GÂY DAMAGE AN TOÀN KHÔNG BỊ KICK
local function AutoAttack(targetBoss)
    pcall(function()
        local toolName = _G.AttackToolName
        local char = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")

        if char and backpack then
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if toolName and toolName ~= "" then
                local tool = backpack:FindFirstChild(toolName)
                if tool and hum then
                    hum:EquipTool(tool)
                end
            else
                if not char:FindFirstChildOfClass("Tool") then
                    local tool = backpack:FindFirstChildOfClass("Tool")
                    if tool and hum then hum:EquipTool(tool) end
                end
            end
        end

        local EquippedTool = char and char:FindFirstChildOfClass("Tool")
        if EquippedTool then 
            if targetBoss and targetBoss:FindFirstChild("HumanoidRootPart") then
                local handle = EquippedTool:FindFirstChild("Handle") or EquippedTool:FindFirstChildOfClass("BasePart")
                if handle and firetouchinterest then
                    firetouchinterest(handle, targetBoss.HumanoidRootPart, 0)
                    firetouchinterest(handle, targetBoss.HumanoidRootPart, 1)
                end
            end
            EquippedTool:Activate() 
        end
        
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

