local ConfigFolder = "TKZ_Config"
local ConfigFile = ConfigFolder .. "/FarmConfig.json"

local function SavePositionsToConfig()
    pcall(function()
        if writefile and isfolder then
            if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
            local dataToSave = {}
            if _G.FarmBanhMiPos then dataToSave.FarmBanhMiPos = {_G.FarmBanhMiPos.X, _G.FarmBanhMiPos.Y, _G.FarmBanhMiPos.Z} end
            if _G.FarmBenhVienPos then dataToSave.FarmBenhVienPos = {_G.FarmBenhVienPos.X, _G.FarmBenhVienPos.Y, _G.FarmBenhVienPos.Z} end
            if _G.FarmCaoSuPos then dataToSave.FarmCaoSuPos = {_G.FarmCaoSuPos.X, _G.FarmCaoSuPos.Y, _G.FarmCaoSuPos.Z} end
            if _G.FarmChotCongAnPos then dataToSave.FarmChotCongAnPos = {_G.FarmChotCongAnPos.X, _G.FarmChotCongAnPos.Y, _G.FarmChotCongAnPos.Z} end
            writefile(ConfigFile, HttpService:JSONEncode(dataToSave))
        end
    end)
end

local function LoadPositionsFromConfig()
    pcall(function()
        if isfile and readfile and isfile(ConfigFile) then
            local success, result = pcall(function() return HttpService:JSONDecode(readfile(ConfigFile)) end)
            if success and type(result) == "table" then
                if result.FarmBanhMiPos then _G.FarmBanhMiPos = Vector3.new(unpack(result.FarmBanhMiPos)) end
                if result.FarmBenhVienPos then _G.FarmBenhVienPos = Vector3.new(unpack(result.FarmBenhVienPos)) end
                if result.FarmCaoSuPos then _G.FarmCaoSuPos = Vector3.new(unpack(result.FarmCaoSuPos)) end
                if result.FarmChotCongAnPos then _G.FarmChotCongAnPos = Vector3.new(unpack(result.FarmChotCongAnPos)) end
            end
        end
    end)
end

